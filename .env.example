# Anthropic API Configuration
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env:    cp .env.example .env
# 2. Get your API key from:     https://console.anthropic.com/
# 3. Replace the value below with your actual API key
# 4. The scripts will automatically load this file!
#
# IMPORTANT: Never commit the .env file to git (it's in .gitignore)

ANTHROPIC_API_KEY=sk-ant-api03-your-api-key-here

# Optional: Specify default model
# DEFAULT_MODEL=claude-sonnet-4-5-20250929

# Optional: Specify default skill name
# DEFAULT_SKILL=company-evaluator

# Optional: Set max tokens for responses
# MAX_TOKENS=4096

# Optional: Set temperature for responses (0.0 to 1.0)
# TEMPERATURE=1.0
